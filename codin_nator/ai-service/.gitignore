# --- Python 기본 ---
# 컴파일된 바이트코드 무시 (필수)
__pycache__/
*.py[cod]
*$py.class

# --- 환경 설정 및 보안 (가장 중요) ---
# API Key가 들어있는 환경변수 파일은 절대 올리면 안 됩니다.
.env
.venv
env/
venv/
ENV/

# --- IDE 설정 (사용하는 에디터에 따라) ---
# VS Code 설정 폴더
.vscode/
# PyCharm(IntelliJ) 설정 폴더
.idea/

# --- 운영체제 잡동사니 ---
.DS_Store
Thumbs.db

# --- 로그 파일 (생길 경우) ---
*.log